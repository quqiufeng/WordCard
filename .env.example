# ── 翻译后端 ─────────────────────────────────────────────
# local = 本地 llama.cpp（默认）；deepseek = 在线 API；auto = 有 key 才在线
WC_TRANSLATE_BACKEND=local
# 要用 DeepSeek 时改成：
# WC_TRANSLATE_BACKEND=deepseek

# DeepSeek（OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
# 可选：直接指定完整 endpoint（优先于 BASE_URL）
# DEEPSEEK_CHAT_URL=https://api.deepseek.com/chat/completions

# ── 本地 llama.cpp（可选）────────────────────────────────
# WC_LLM_MODEL=/data/models/Hunyuan-MT-7B-Q4_K_M.gguf
# WC_LLM_URL=http://127.0.0.1:8081
# WC_TERMINAL=xterm

# ── 口语对话（本地语音运行时 voice/agent）────────────────
# 口语 AI 回复/话题固定走 DeepSeek API
# VOICE_MIC_DEV=plughw:2,0
# KOKORO_SID_EN=3               # 英文音色（0-19）
# WC_ASR_LANG=en
# WC_TTS_MUTE=1                 # 调试：不播放 TTS

# ── 口语大脑（独立 tmux）────────────────────────────────
# WC_BRAIN_URL=http://127.0.0.1:4098
# WORDCARD_BRAIN_PORT=4098
# WORDCARD_BRAIN_SESSION=wordcard-brain
